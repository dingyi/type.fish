{
  "$schema": "./node_modules/@biomejs/biome/configuration_schema.json",
  "extends": ["ultracite/biome/core", "ultracite/biome/react"],
  "files": {
    "includes": ["!!public/data"]
  },
  "assist": {
    "actions": {
      "source": {
        "useSortedKeys": "off"
      }
    }
  },
  "linter": {
    "rules": {
      "performance": {
        "noJsxPropsBind": "off"
      },
      "suspicious": {
        "noLeakedRender": "off"
      },
      "style": {
        "useFilenamingConvention": {
          "level": "error",
          "options": {
            "filenameCases": ["kebab-case", "PascalCase"]
          }
        },
        "noNonNullAssertion": "off"
      }
    }
  },
  "overrides": [
    {
      // Astro frontmatter is fenced TS; Biome does not parse the markup below
      // it, so variables used only in the template read as unused. Disable those.
      "includes": ["**/*.astro"],
      "linter": {
        "rules": {
          "correctness": {
            "noUnusedVariables": "off",
            "noUnusedImports": "off",
            "useExhaustiveDependencies": "off"
          },
          "suspicious": {
            "useAwait": "off",
            "noShadow": "off"
          }
        }
      }
    },
    {
      // Generated data files — do not lint or reformat by hand.
      "includes": ["src/data/foundry-bridge.ts"],
      "linter": {
        "rules": {
          "performance": "off"
        }
      }
    }
  ]
}
