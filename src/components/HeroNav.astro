---
// Top navigation. Server-rendered; active-link state computed from the current
// URL path. No client JS.
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";

const navItems = [
  { label: "Foundry", path: "/" },
  { label: "Typefaces", path: "/typefaces" },
  { label: "Open Source", path: "/typefaces/open-source" },
  { label: "Designers", path: "/designers" },
  { label: "Tools", path: "/tools" },
  { label: "About", path: "/about" },
] as const;

function isActive(path: string): boolean {
  if (path === "/typefaces/open-source") {
    return pathname === path;
  }
  if (path === "/typefaces") {
    return (
      pathname === path ||
      (pathname.startsWith("/typefaces/") &&
        pathname !== "/typefaces/open-source")
    );
  }
  return pathname === path;
}
---

<header class="pt-10 pb-6">
  <div class="flex flex-wrap items-center justify-between gap-x-4 gap-y-3">
    <!-- Brand: div, not h1 — the page's single H1 belongs to the page content. -->
    <a href="/" class="font-semibold text-base text-foreground tracking-tight">
      type.fish
    </a>
    <nav class="flex flex-wrap items-center gap-1">
      {
        navItems.map((item) => (
          <a
            class={`rounded-full px-3 py-1 text-sm transition-colors ${
              isActive(item.path)
                ? "bg-foreground text-background"
                : "text-muted-foreground hover:bg-muted hover:text-foreground"
            }`}
            href={item.path}
          >
            {item.label}
          </a>
        ))
      }
      <a
        class="ml-2 inline-flex items-center gap-1 rounded-full bg-foreground px-3 py-1 text-background text-sm transition-colors hover:bg-foreground/85"
        href="/submit"
      >
        Submit
        <svg
          aria-hidden="true"
          class="h-3 w-3"
          fill="none"
          stroke="currentColor"
          stroke-linecap="round"
          stroke-linejoin="round"
          stroke-width="2"
          viewBox="0 0 24 24"
        >
          <path d="M12 5v14" />
          <path d="M5 12h14" />
        </svg>
      </a>
    </nav>
  </div>
  <hr class="mt-6 border-border" />
</header>
