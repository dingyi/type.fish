---
import { CountryFlag } from "@/components/CountryFlag.tsx";
import { type Foundry, foundries } from "@/data/foundries";
import { foundrySlugByLocalId } from "@/data/foundry-bridge";
import BaseLayout from "@/layouts/BaseLayout.astro";
import typefacesData from "../../public/data/typefaces.json";

const gitDate = import.meta.env.PUBLIC_GIT_DATE as string;

// Overview stats
const total = foundries.length;
let withFounded = 0;
for (const f of foundries) {
  if (f.founded && !Number.isNaN(Number.parseInt(f.founded, 10))) {
    withFounded += 1;
  }
}
const withFontLists = foundries.filter((f) => f.notableFonts?.length).length;

// Country distribution
const countryCountMap = new Map<string, number>();
for (const f of foundries) {
  const c = f.country || "Unknown";
  countryCountMap.set(c, (countryCountMap.get(c) || 0) + 1);
}
const countryCount = countryCountMap.size;
const topCountries = [...countryCountMap.entries()]
  .sort((a, b) => b[1] - a[1])
  .slice(0, 12)
  .map(([name, count]) => ({ name, count }));

// Category distribution
const categoryMeta: Record<Foundry["category"], { label: string }> = {
  classic: { label: "Classic" },
  modern: { label: "Modern" },
  indie: { label: "Indie" },
  tech: { label: "Tech" },
  studio: { label: "Studio" },
};
const categoryCountMap = new Map<string, number>();
for (const f of foundries) {
  categoryCountMap.set(f.category, (categoryCountMap.get(f.category) || 0) + 1);
}
const categoryRows = (
  ["classic", "modern", "studio", "indie", "tech"] as Foundry["category"][]
)
  .map((key) => ({
    key,
    label: categoryMeta[key].label,
    count: categoryCountMap.get(key) || 0,
  }))
  .sort((a, b) => b.count - a.count);
const maxCategoryCount = Math.max(...categoryRows.map((r) => r.count), 1);

// Typeface coverage
const bridgedFoundryCount = Object.keys(foundrySlugByLocalId).length;
const openSourceCount = typefacesData.filter((t) => t.isOpenSource).length;

const title = "About type.fish";
const description =
  "type.fish is an open directory of type foundries, cataloguing type design companies, studios, and independent designers from around the world.";
---

<BaseLayout title={title} description={description}>
  {/* Intro */}
  <section class="py-10">
    <p class="mb-2 font-medium font-mono text-muted-foreground text-xs tracking-tight">
      About type.fish
    </p>
    <h1 class="mb-6 font-bold text-3xl text-foreground tracking-tight">
      Global Type Foundry Directory
    </h1>
    <div class="max-w-2xl space-y-4 text-foreground/80 text-sm leading-relaxed">
      <p>
        type.fish is an open directory of type foundries, cataloguing type
        design companies, studios, and independent designers from around the
        world.
      </p>
      <p>
        We aim to offer type lovers, designers, and developers a clear,
        searchable list of foundries — from century-old houses like Monotype
        and Linotype to one-person studios that have published a single
        typeface, all listed on equal footing.
      </p>
      <p class="text-muted-foreground">No ratings, no paid placement — just the facts.</p>
    </div>
  </section>

  <hr class="border-border" />

  {/* Stats */}
  <section class="py-10">
    <p class="mb-6 font-medium font-mono text-muted-foreground text-xs tracking-tight">
      Overview
    </p>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {total.toLocaleString("en-US")}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">Foundries</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {countryCount}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">Countries</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {withFounded.toLocaleString("en-US")}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">With founding year</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {withFontLists.toLocaleString("en-US")}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">With font lists</p>
      </div>
    </div>
    <p class="mt-3 font-mono text-muted-foreground text-xs">
      Data updated {new Date(gitDate).toLocaleDateString("en-US")}
    </p>
  </section>

  <hr class="border-border" />

  {/* Typeface coverage */}
  <section class="py-10">
    <p class="mb-2 font-medium font-mono text-muted-foreground text-xs tracking-tight">
      Typeface Coverage
    </p>
    <p class="mb-6 max-w-2xl text-foreground/80 text-sm leading-relaxed">
      {bridgedFoundryCount.toLocaleString("en-US")} of {total.toLocaleString("en-US")} foundries are linked to typeface detail records.
    </p>
    <div class="grid grid-cols-2 gap-3 sm:grid-cols-3 lg:grid-cols-4">
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {typefacesData.length.toLocaleString("en-US")}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">Typefaces catalogued</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {bridgedFoundryCount.toLocaleString("en-US")}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">Foundries with typefaces</p>
      </div>
      <div class="rounded-xl border border-border bg-card p-4">
        <p class="font-bold font-mono text-2xl text-foreground tabular-nums tracking-tight">
          {openSourceCount.toLocaleString("en-US")}
        </p>
        <p class="mt-1 font-mono text-muted-foreground text-xs">Open source (OFL)</p>
      </div>
    </div>
  </section>

  <hr class="border-border" />

  {/* Top countries */}
  <section class="py-10">
    <p class="mb-2 font-medium font-mono text-muted-foreground text-xs tracking-tight">By Country</p>
    <p class="mb-6 max-w-2xl text-foreground/80 text-sm leading-relaxed">
      Foundries span {countryCount} countries and regions. The top entries:
    </p>
    <div class="flex flex-wrap gap-1.5">
      {topCountries.map((c) => (
        <span class="inline-flex items-center gap-1.5 rounded-full bg-muted px-3 py-1 text-muted-foreground text-xs">
          <CountryFlag country={c.name} client:load />
          {c.name}
          <span class="font-mono text-foreground/60 tabular-nums">{c.count}</span>
        </span>
      ))}
    </div>
  </section>

  <hr class="border-border" />

  {/* Categories */}
  <section class="py-10">
    <p class="mb-6 font-medium font-mono text-muted-foreground text-xs tracking-tight">By Category</p>
    <div class="space-y-3">
      {categoryRows.map((row) => (
        <div class="flex items-center gap-3">
          <span class="w-16 shrink-0 font-mono text-foreground text-xs">{row.label}</span>
          <div class="h-1.5 flex-1 overflow-hidden rounded-full bg-muted">
            <div
              class="h-full rounded-full bg-foreground"
              style={`width:${(row.count / maxCategoryCount) * 100}%`}
            />
          </div>
          <span class="w-10 shrink-0 text-right font-mono text-muted-foreground text-xs tabular-nums">
            {row.count}
          </span>
        </div>
      ))}
    </div>
  </section>

  <hr class="border-border" />

  {/* Data sources */}
  <section class="py-10">
    <p class="mb-6 font-medium font-mono text-muted-foreground text-xs tracking-tight">Data Sources</p>
    <div class="max-w-2xl space-y-3 text-foreground/80 text-sm leading-relaxed">
      <p>
        Foundry data is compiled from publicly available information, with a portion
        imported from
        <a
          class="text-foreground underline underline-offset-2 hover:text-muted-foreground"
          href="https://type.lol"
          rel="noopener noreferrer"
          target="_blank">type.lol</a>
        — our thanks to them.
      </p>
      <p class="text-muted-foreground">
        We strive for accuracy, but omissions happen. If you spot an error or a
        missing foundry, please send a correction via the options below.
      </p>
    </div>
  </section>
</BaseLayout>
