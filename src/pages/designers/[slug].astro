---
import { CountryFlag } from "@/components/CountryFlag.tsx";
import { designers } from "@/data/designers";
import { foundries } from "@/data/foundries";
import { designerSlugByName } from "@/data/foundry-bridge";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugifyName } from "@/lib/slug";
import indexMaps from "../../../public/data/index-maps.json";
import typefacesData from "../../../public/data/typefaces.json";

export async function getStaticPaths() {
  return designers.map((designer) => ({
    params: { slug: slugifyName(designer.name) },
    props: { designer },
  }));
}

interface Props {
  designer: (typeof designers)[number];
}
const { designer } = Astro.props;

const tlSlug = designerSlugByName[designer.name];
const typefaceIds = tlSlug ? (indexMaps.byDesigner[tlSlug] ?? []) : [];
const designerTypefaces = typefaceIds
  .map((id) => typefacesData.find((t) => t.id === id))
  .filter((t): t is (typeof typefacesData)[number] => Boolean(t));

const title = `${designer.name} · type.fish`;
const description =
  designer.bio ??
  `${designer.name} — a type designer${designer.country ? ` from ${designer.country}` : ""}.`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: designer.name,
  ...(designer.bio ? { description: designer.bio } : {}),
  ...(designer.country ? { nationality: designer.country } : {}),
  jobTitle: "Type Designer",
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <a class="mb-6 inline-flex items-center gap-1 font-mono text-muted-foreground text-xs hover:text-foreground" href="/designers">
    ← All designers
  </a>

  <header class="space-y-3">
    <div class="flex flex-wrap items-center gap-3">
      <h1 class="font-bold text-3xl text-foreground tracking-tight">{designer.name}</h1>
      <span class="inline-flex items-center gap-1.5 rounded-full bg-muted px-3 py-1 text-muted-foreground text-xs">
        <CountryFlag country={designer.country} client:load />
        {designer.country}
      </span>
    </div>
    {designer.bio && (
      <p class="max-w-2xl text-foreground/80 text-sm leading-relaxed">{designer.bio}</p>
    )}
    <p class="font-mono text-muted-foreground text-xs">
      {designer.workCount.toLocaleString("en-US")} works
    </p>
  </header>

  <hr class="border-border my-8" />

  {designer.foundries.length > 0 && (
    <section class="mb-10">
      <p class="mb-3 font-medium font-mono text-muted-foreground text-xs tracking-tight">Foundries</p>
      <div class="flex flex-wrap gap-1.5">
        {designer.foundries.map((fname) => {
          const local = foundries.find((f) => f.name === fname);
          return local ? (
            <a class="rounded-full bg-muted px-3 py-1 text-muted-foreground text-xs hover:bg-accent hover:text-foreground" href={`/foundries/${local.id}`}>
              {fname}
            </a>
          ) : (
            <span class="rounded-full bg-muted px-3 py-1 text-muted-foreground/60 text-xs">{fname}</span>
          );
        })}
        {designer.foundryCount > designer.foundries.length && (
          <span class="rounded-full px-3 py-1 font-mono text-muted-foreground/40 text-xs">
            +{designer.foundryCount - designer.foundries.length}
          </span>
        )}
      </div>
    </section>
  )}

  <section>
    <p class="mb-3 font-medium font-mono text-muted-foreground text-xs tracking-tight">
      Typefaces in the catalogue
    </p>
    {!tlSlug && <p class="text-muted-foreground text-sm">type.fish has not yet linked this designer to typeface detail records.</p>}
    {tlSlug && designerTypefaces.length === 0 && (
      <p class="text-muted-foreground text-sm">No typeface details recorded for this designer yet.</p>
    )}
    {designerTypefaces.length > 0 && (
      <div class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
        {designerTypefaces.slice(0, 24).map((t) => (
          <a class="flex flex-col gap-2 rounded-xl border border-border bg-card p-3 hover:bg-accent" href={`/typefaces/${t.id}`}>
            {t.previewImage ? (
              <img class="h-14 w-full rounded bg-muted object-cover" height="56" width="300" loading="lazy" src={t.previewImage} alt={t.name} />
            ) : (
              <div class="flex h-14 items-center justify-center rounded bg-muted/60">
                <span class="font-mono text-muted-foreground/50 text-xs">{t.classification}</span>
              </div>
            )}
            <span class="font-medium text-foreground text-xs">{t.name}</span>
          </a>
        ))}
      </div>
    )}
  </section>
</BaseLayout>
