---
import { FoundryTable } from "@/components/islands/FoundryTable.tsx";
import { foundries } from "@/data/foundries";
import { foundryAssets } from "@/data/foundry-assets";
import BaseLayout from "@/layouts/BaseLayout.astro";

const gitDate = import.meta.env.PUBLIC_GIT_DATE as string;

// Precompute the country facet at build time so the server-rendered HTML shows
// real counts and the hydrated island doesn't recompute them.
const countries = (() => {
  const countMap = new Map<string, number>();
  for (const f of foundries) {
    const c = f.country || "Unknown";
    countMap.set(c, (countMap.get(c) || 0) + 1);
  }
  return [...countMap.entries()]
    .sort((a, b) => b[1] - a[1])
    .map(([name, count]) => ({ name, count }));
})();

const title = "type.fish — Type Foundry Directory";
const description =
  "type.fish is an open directory of type foundries, cataloguing type design companies, studios, and independent designers from around the world.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  name: "type.fish",
  url: "https://type.fish",
  description,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="pt-2 pb-6">
    <h1 class="font-bold text-3xl text-foreground tracking-tight">Foundries</h1>
    <p class="mt-3 max-w-2xl text-foreground/80 text-sm leading-relaxed">
      {description}
    </p>
  </section>
  <FoundryTable
    client:load
    foundries={foundries}
    countries={countries}
    assets={foundryAssets}
    gitDate={gitDate}
  />
</BaseLayout>
