---
import { toolAssets } from "@/data/tool-assets";
import { type FontTool, tools } from "@/data/tools";
import BaseLayout from "@/layouts/BaseLayout.astro";

const categoryMeta: Record<FontTool["category"], { label: string }> = {
  manager: { label: "Managers" },
  editor: { label: "Editors" },
  resource: { label: "Resources" },
};
// Section order on the page; only categories with entries render.
const categoryOrder: FontTool["category"][] = ["manager", "editor", "resource"];

const title = "Font Tools · type.fish";
const description =
  "A curated directory of font tools and resources — managers for organising fonts, editors for producing typefaces, and catalogues for discovering them.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: "Font Tools",
  description,
  url: "https://type.fish/tools",
  mainEntity: {
    "@type": "ItemList",
    itemListElement: tools.map((tool, index) => ({
      "@type": "ListItem",
      position: index + 1,
      name: tool.name,
      url: tool.website,
    })),
  },
};

// Hoisted out of the hot path (Biome useTopLevelRegex).
const WWW_RE = /^www\./;

function hostOf(website: string): string {
  return new URL(website).hostname.replace(WWW_RE, "");
}
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  {/* Intro */}
  <section class="py-10">
    <p class="mb-2 font-medium font-mono text-muted-foreground text-xs tracking-tight">
      Tools
    </p>
    <h1 class="mb-6 font-bold text-3xl text-foreground tracking-tight">
      Font Tools
    </h1>
    <div class="max-w-2xl space-y-4 text-foreground/80 text-sm leading-relaxed">
      <p>
        A curated directory for working with type — font managers for browsing,
        organising and activating fonts, editors for drawing and producing
        them, and resources for discovering new typefaces.
      </p>
      <p class="text-muted-foreground">
        No rankings, no sponsored entries. Suggest a missing tool on
        <a
          class="text-foreground underline underline-offset-2 hover:text-muted-foreground"
          href="https://github.com/dingyi/type.fish"
          rel="noopener noreferrer"
          target="_blank">GitHub</a>.
      </p>
    </div>
  </section>

  {categoryOrder.map((category) => {
    const group = tools.filter((tool) => tool.category === category);
    if (group.length === 0) return null;
    return (
      <section class="border-border border-t py-10">
        <p class="mb-6 font-medium font-mono text-muted-foreground text-xs tracking-tight">
          {categoryMeta[category].label}
          <span class="ml-2 text-foreground/40 tabular-nums">{group.length}</span>
        </p>
        <div class="grid gap-3 sm:grid-cols-2 lg:grid-cols-3">
          {group.map((tool) => {
            const asset = toolAssets[tool.slug];
            return (
              <a
                class="group flex flex-col rounded-xl border border-border bg-card p-5 transition-colors hover:border-foreground/30"
                href={tool.website}
                rel="noopener noreferrer"
                target="_blank"
              >
                <div class="flex items-center gap-3">
                  <span class="flex h-10 w-10 shrink-0 items-center justify-center overflow-hidden rounded-lg bg-muted">
                    {asset?.favicon ? (
                      <img
                        alt=""
                        class="h-6 w-6 object-contain"
                        decoding="async"
                        height={24}
                        loading="lazy"
                        src={asset.favicon}
                        width={24}
                      />
                    ) : (
                      <span class="font-semibold text-muted-foreground text-xs">
                        {tool.name.slice(0, 1)}
                      </span>
                    )}
                  </span>
                  <div class="min-w-0">
                    <p class="font-semibold text-foreground">{tool.name}</p>
                    <p class="truncate font-mono text-muted-foreground text-xs">
                      {hostOf(tool.website)}
                    </p>
                  </div>
                  <svg
                    aria-hidden="true"
                    class="ml-auto h-4 w-4 shrink-0 text-muted-foreground transition-colors group-hover:text-foreground"
                    fill="none"
                    stroke="currentColor"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    viewBox="0 0 24 24"
                  >
                    <path d="M7 7h10v10" />
                    <path d="M7 17 17 7" />
                  </svg>
                </div>
                <p class="mt-3 flex-1 text-foreground/80 text-sm leading-relaxed">
                  {tool.tagline}
                </p>
                <div class="mt-4 flex flex-wrap gap-1.5">
                  {tool.platforms.map((platform) => (
                    <span class="rounded-full bg-muted px-2.5 py-0.5 font-mono text-muted-foreground text-xs">
                      {platform}
                    </span>
                  ))}
                </div>
              </a>
            );
          })}
        </div>
      </section>
    );
  })}
</BaseLayout>
