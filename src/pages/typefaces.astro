---
import { TypefaceGrid } from "@/components/islands/TypefaceGrid.tsx";
import type { Typeface } from "@/data/typefaces";
import BaseLayout from "@/layouts/BaseLayout.astro";
import typefacesData from "../../public/data/typefaces.json";

const typefaces = typefacesData as Typeface[];

const isOpenSource = Astro.url.searchParams.get("license") === "open-source";

const title = isOpenSource
  ? "Open Source Typefaces · type.fish"
  : "Typefaces · type.fish";
const description = isOpenSource
  ? "Open-source typefaces released under libre licenses (principally the SIL Open Font License). Usable and modifiable by anyone."
  : "Browse the type.fish typeface catalogue — typefaces from independent and established foundries worldwide.";

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CollectionPage",
  name: title,
  description,
  url: "https://type.fish/typefaces",
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="pt-2 pb-6">
    <h1 class="font-bold text-3xl text-foreground tracking-tight">
      {isOpenSource ? "Open Source Typefaces" : "Typefaces"}
    </h1>
    {isOpenSource && (
      <p class="mt-3 max-w-2xl text-foreground/80 text-sm leading-relaxed">
        Open-source typefaces released under libre licenses (principally the SIL
        Open Font License). Usable and modifiable by anyone.
      </p>
    )}
  </section>
  <TypefaceGrid client:load typefaces={typefaces} />
</BaseLayout>
