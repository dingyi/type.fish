---
import { designers } from "@/data/designers";
import { foundries } from "@/data/foundries";
import {
  designerSlugByName,
  localIdByFoundrySlug,
} from "@/data/foundry-bridge";
import type { Typeface } from "@/data/typefaces";
import BaseLayout from "@/layouts/BaseLayout.astro";
import { slugifyName } from "@/lib/slug";
import typefacesData from "../../../public/data/typefaces.json";

export async function getStaticPaths() {
  return (typefacesData as Typeface[]).map((typeface) => ({
    params: { slug: typeface.id },
    props: { typeface },
  }));
}

interface Props {
  typeface: Typeface;
}
const { typeface } = Astro.props;

const localFoundryId = localIdByFoundrySlug[typeface.foundryId];
const foundry = foundries.find((entry) => entry.id === localFoundryId);
const designerNameBySourceSlug = new Map(
  Object.entries(designerSlugByName).map(([name, slug]) => [slug, name])
);
const creditedDesigners = typeface.designerIds.map((id) => ({
  id,
  name: designerNameBySourceSlug.get(id) ?? id,
}));
const knownDesignerNames = new Set(designers.map((designer) => designer.name));

const foundryUrl = foundry
  ? new URL(
      foundry.website.startsWith("http")
        ? foundry.website
        : `https://${foundry.website}`
    ).href
  : undefined;

const title = `${typeface.name} · type.fish`;
const description =
  typeface.description ??
  `${typeface.name} — a ${typeface.classification} typeface.`;
const pageUrl = `https://type.fish/typefaces/${typeface.id}/`;

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "CreativeWork",
  name: typeface.name,
  description,
  url: pageUrl,
  mainEntityOfPage: pageUrl,
  genre: `${typeface.classification} typeface`,
  ...(typeface.releaseYear
    ? { datePublished: String(typeface.releaseYear) }
    : {}),
  ...(foundry
    ? {
        publisher: {
          "@type": "Organization",
          name: foundry.name,
          ...(foundryUrl ? { url: foundryUrl } : {}),
        },
      }
    : {}),
  ...(creditedDesigners.length > 0
    ? {
        creator: creditedDesigners.map((designer) => ({
          "@type": "Person",
          name: designer.name,
        })),
      }
    : {}),
  ...(typeface.scripts.length > 0
    ? {
        additionalProperty: typeface.scripts.map((script) => ({
          "@type": "PropertyValue",
          name: "Writing system",
          value: script,
        })),
      }
    : {}),
  isAccessibleForFree: typeface.isOpenSource,
  license: typeface.isOpenSource
    ? "https://opensource.org/licenses/OFL-1.1"
    : undefined,
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <a class="mb-6 inline-flex items-center gap-1 font-mono text-muted-foreground text-xs hover:text-foreground" href="/typefaces">
    ← All typefaces
  </a>

  <div class="grid grid-cols-1 gap-8 lg:grid-cols-3">
    {/* Specimen */}
    <div class="lg:col-span-2">
      {typeface.previewImage ? (
        <img class="w-full rounded-xl border border-border object-cover" height="500" width="800" src={typeface.previewImage} alt={typeface.name} />
      ) : (
        <div class="flex aspect-[2/1] items-center justify-center rounded-xl border border-border bg-muted/40">
          <span class="font-mono text-4xl text-foreground/40">{typeface.name}</span>
        </div>
      )}
    </div>

    {/* Metadata */}
    <div class="space-y-6">
      <div>
        <div class="mb-1 flex items-center gap-2">
          <h1 class="font-bold text-2xl text-foreground tracking-tight">{typeface.name}</h1>
          {typeface.isOpenSource && (
            <span class="rounded-full bg-foreground/10 px-2 py-0.5 font-mono text-[10px] tracking-wider text-foreground/70 uppercase">
              Open Source
            </span>
          )}
        </div>
        <p class="font-mono text-muted-foreground text-xs">
          {typeface.classification}{typeface.isVariable && " · variable"}{typeface.hasItalic && " · italic"}{typeface.releaseYear && ` · ${typeface.releaseYear}`}
        </p>
      </div>

      {typeface.description && (
        <p class="text-foreground/80 text-sm leading-relaxed">{typeface.description}</p>
      )}
      {!typeface.description && (
        <p class="text-foreground/80 text-sm leading-relaxed">{description}</p>
      )}

      <dl class="space-y-3 font-mono text-xs">
        <div class="flex items-baseline justify-between gap-4 border-border border-b pb-2">
          <dt class="text-muted-foreground/60 uppercase">Foundry</dt>
          <dd class="text-right">
            {localFoundryId ? (
              <a class="text-foreground underline-offset-2 hover:underline" href={`/foundries/${localFoundryId}`}>
                {foundry?.name ?? typeface.foundryId}
              </a>
            ) : (
              <span class="text-muted-foreground">{typeface.foundryId}</span>
            )}
          </dd>
        </div>
        {typeface.designerIds.length > 0 && (
          <div class="flex items-baseline justify-between gap-4 border-border border-b pb-2">
            <dt class="text-muted-foreground/60 uppercase">Designers</dt>
            <dd class="text-right text-muted-foreground">
              {creditedDesigners.map((designer, index) => (
                <>
                  {index > 0 && ", "}
                  {knownDesignerNames.has(designer.name) ? (
                    <a class="text-foreground underline-offset-2 hover:underline" href={`/designers/${slugifyName(designer.name)}`}>
                      {designer.name}
                    </a>
                  ) : (
                    designer.name
                  )}
                </>
              ))}
            </dd>
          </div>
        )}
        {typeface.scripts.length > 0 && (
          <div class="flex items-baseline justify-between gap-4 border-border border-b pb-2">
            <dt class="text-muted-foreground/60 uppercase">Scripts</dt>
            <dd class="text-right text-muted-foreground">{typeface.scripts.join(", ")}</dd>
          </div>
        )}
        {typeface.specimenUrl && (
          <div class="flex items-baseline justify-between gap-4 border-border border-b pb-2">
            <dt class="text-muted-foreground/60 uppercase">Specimen</dt>
            <dd class="text-right">
              <a class="inline-flex items-center gap-1 text-foreground underline-offset-2 hover:underline" href={typeface.specimenUrl} rel="noopener noreferrer" target="_blank">
                View ↗
              </a>
            </dd>
          </div>
        )}
      </dl>
    </div>
  </div>
</BaseLayout>
