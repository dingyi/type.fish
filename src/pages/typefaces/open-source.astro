---
import { TypefaceGrid } from "@/components/islands/TypefaceGrid.tsx";
import type { Typeface } from "@/data/typefaces";
import BaseLayout from "@/layouts/BaseLayout.astro";
import typefacesData from "../../../public/data/typefaces.json";

const openSourceTypefaces = (typefacesData as Typeface[])
  .filter((typeface) => typeface.isOpenSource)
  .sort((a, b) => a.name.localeCompare(b.name));
const initialTypefaces = openSourceTypefaces.slice(0, 48);

const title = "Open Source Typefaces · type.fish";
const description =
  "Open-source typefaces in the type.fish catalogue are font families marked as freely usable and modifiable, principally under the SIL Open Font License.";

const featuredProjects = [
  {
    name: "ShieldFont",
    description:
      "An open-source creative technology project that protects writing from unauthorized AI training. Generate OFL-licensed variants from compatible open fonts, or try the live encoder.",
    website: "https://shieldfont.org/",
    source: "https://github.com/isaqueseneda/shieldfont",
  },
  {
    name: "Sunghyun Sans",
    description:
      "A rounded, multilingual typeface with nine weights across Latin, Cyrillic, Greek, Vietnamese, Korean, Japanese, and Chinese, released under the SIL Open Font License.",
    website: "https://cho.sh/mini/sans",
    source: "https://github.com/anaclumos/sunghyun-sans",
  },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": ["CollectionPage", "ItemList"],
  name: title,
  description,
  url: "https://type.fish/typefaces/open-source/",
  numberOfItems: openSourceTypefaces.length,
  itemListElement: initialTypefaces.map((typeface, index) => ({
    "@type": "ListItem",
    position: index + 1,
    name: typeface.name,
    url: `https://type.fish/typefaces/${typeface.id}/`,
  })),
};
---

<BaseLayout title={title} description={description} jsonLd={jsonLd}>
  <section class="pt-2 pb-6">
    <h1 class="font-bold text-3xl text-foreground tracking-tight">
      Open Source Typefaces
    </h1>
    <p class="mt-3 max-w-2xl text-foreground/80 text-sm leading-relaxed">
      {description}
    </p>
  </section>
  <section class="mb-8" aria-labelledby="featured-open-source-project">
    <div class="mb-3 flex items-baseline justify-between gap-3">
      <h2
        id="featured-open-source-project"
        class="font-bold text-foreground text-lg tracking-tight"
      >
        Featured open-source project
      </h2>
      <span class="font-mono text-muted-foreground text-[10px] uppercase tracking-wider">
        Project
      </span>
    </div>
    <div class="grid gap-3 md:grid-cols-2">
      {featuredProjects.map((project) => (
        <div class="rounded-xl border border-border bg-card p-4">
          <div class="flex h-full flex-col gap-3">
            <div class="max-w-2xl">
              <h3 class="font-medium text-foreground text-sm">{project.name}</h3>
              <p class="mt-1 text-foreground/75 text-sm leading-relaxed">
                {project.description}
              </p>
            </div>
            <div class="mt-auto flex gap-3 pt-1 font-mono text-xs">
              <a
                class="text-foreground underline underline-offset-4 hover:text-foreground/70"
                href={project.website}
                rel="noopener noreferrer"
                target="_blank"
              >
                Website ↗
              </a>
              <a
                class="text-muted-foreground underline underline-offset-4 hover:text-foreground"
                href={project.source}
                rel="noopener noreferrer"
                target="_blank"
              >
                Source ↗
              </a>
            </div>
          </div>
        </div>
      ))}
    </div>
  </section>
  <TypefaceGrid
    client:load
    initialOpenSource
    initialTypefaces={initialTypefaces}
    totalCount={openSourceTypefaces.length}
  />
</BaseLayout>
